# Example only: the Go service reads process environment, not .env automatically.
# Copy settings into a private service configuration; never commit real hashes.
PORTRAIT_STUDIO_ADMIN_USERNAME=admin

# Choose one credential source. This path contains a hash, never a raw password.
# Initialize it interactively with portrait-server init-admin -auth-file PATH.
PORTRAIT_STUDIO_AUTH_FILE=/home/ubuntu/portrait-studio/config/admin-auth.json

# Alternative: a user-initialized Argon2id PHC hash supplied by a secret manager
# or an EnvironmentFile. Do not enable this together with AUTH_FILE.
# PORTRAIT_STUDIO_ADMIN_PASSWORD_HASH=<user-initialized-argon2id-PHC-hash>

# There is no default password, plaintext-password variable or public sign-up.
