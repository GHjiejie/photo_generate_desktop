{
  "name": "portrait-studio",
  "version": "1.6.0",
  "description": "A desktop gallery for curated AI portrait prompts",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "vite",
    "build": "vite build",
    "check": "node --check auth-dialog.cjs && node --check auth-preload.js && node --check auth-renderer.js && node --check main.js && node --check preload.js && node --check electron-security.cjs && node --check remote-source.cjs && node --check remote-config.cjs && node --check remote-client.cjs && node --check remote-electron.cjs && node --check remote-preview.cjs && node --check local-electron.cjs && node --check local-library.cjs && node --check batch-import.cjs && node --check library-batch-transaction.cjs && node --check localization.cjs && node --check preview-library.cjs && npm run build",
    "test": "node --test tests/*.test.cjs",
    "test:electron": "npm run build && node scripts/verify-external-library.cjs",
    "package": "npm run build && electron-builder --dir --mac --arm64",
    "dist:mac": "npm run package && node scripts/create-mac-artifacts.cjs",
    "test:batch": "npm run build && node scripts/verify-batch-import.cjs",
    "test:server": "cd server && go test ./...",
    "test:remote": "npm run build && node scripts/verify-remote-native.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^42.11.10",
    "electron-builder": "^26.0.12",
    "pngjs": "^7.0.0",
    "vite": "^8.3.2"
  },
  "build": {
    "appId": "com.jie.portraitstudio",
    "productName": "Portrait Studio",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "electron-security.cjs",
      "auth.css",
      "auth.html",
      "auth-renderer.js",
      "auth-preload.js",
      "auth-dialog.cjs",
      "remote-source.cjs",
      "remote-config.cjs",
      "remote-electron.cjs",
      "remote-client.cjs",
      "local-electron.cjs",
      "local-library.cjs",
      "batch-import.cjs",
      "library-batch-transaction.cjs",
      "assets/default-library.json",
      "renderer-dist/**/*",
      "!node_modules/**/*",
      "!assets/images/**/*",
      "!photo_repo/**/*",
      "localization.cjs",
      "system-messages.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "notarize": false,
      "artifactName": "Portrait-Studio-React-${version}-${arch}.${ext}"
    },
    "electronDist": "node_modules/electron/dist",
    "afterPack": "./scripts/sign-local.cjs"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "googleapis": "^183.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
